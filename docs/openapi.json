  },
  "components": {
    "schemas": {
      "CreateIngestionJobRequest": {
        "properties": {
          "entity": {
            "$ref": "#/components/schemas/IngestionEntity"
          },
          "manifest_path": {
            "type": "string",
            "minLength": 1,
            "title": "Manifest Path"
          },
          "collection_name": {
            "type": "string",
            "minLength": 1,
            "title": "Collection Name"
          },
          "feature_profile": {
            "type": "string",
            "minLength": 1,
            "title": "Feature Profile"
          }
        },
        "type": "object",
        "required": [
          "entity",
          "manifest_path",
          "collection_name",
          "feature_profile"
        ],
        "title": "CreateIngestionJobRequest"
      },
      "CreateIngestionJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/IngestionStatus",
            "default": "queued"
          },
          "collection_name": {
            "type": "string",
            "title": "Collection Name"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "collection_name"
        ],
        "title": "CreateIngestionJobResponse"
      },
      "ExportFormat": {
        "type": "string",
        "enum": [
          "csv",
          "json"
        ],
        "title": "ExportFormat"
      },
      "ExportRequest": {
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "kis",
              "qa",
              "trake"
            ],
            "title": "Task"
          },
          "format": {
            "$ref": "#/components/schemas/ExportFormat",
            "default": "csv"
          },
          "event_slot_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Slot Count"
          },
          "candidates": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/KisCandidate"
                },
                {
                  "$ref": "#/components/schemas/QaCandidate"
                },
                {
                  "$ref": "#/components/schemas/TrakeCandidate"
                }
              ],
              "discriminator": {
                "propertyName": "task",
                "mapping": {
                  "kis": "#/components/schemas/KisCandidate",
                  "qa": "#/components/schemas/QaCandidate",
                  "trake": "#/components/schemas/TrakeCandidate"
                }
              }
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Candidates"
          }
        },
        "type": "object",
        "required": [
          "task",
          "candidates"
        ],
        "title": "ExportRequest"
      },
      "FeatureProfileOption": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "dimension": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Dimension"
          },
          "clip_frame_count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Clip Frame Count"
          },
          "image_batch_size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Image Batch Size"
          }
        },
        "type": "object",
        "required": [
          "name",
          "model_id",
          "dimension",
          "clip_frame_count",
          "image_batch_size"
        ],
        "title": "FeatureProfileOption"
      },
      "FrameContext": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "frame_id": {
            "type": "integer",
            "title": "Frame Id"
          },
          "keyframe_n": {
            "type": "integer",
            "title": "Keyframe N"
          },
          "pts_sec": {
            "type": "number",
            "title": "Pts Sec"
          },
          "shot_id": {
            "type": "integer",
            "title": "Shot Id"
          },
          "shot_start_sec": {
            "type": "number",
            "title": "Shot Start Sec"
          },
          "shot_end_sec": {
            "type": "number",
            "title": "Shot End Sec"
          },
          "shot_start_frame": {
            "type": "integer",
            "title": "Shot Start Frame"
          },
          "shot_end_frame": {
            "type": "integer",
            "title": "Shot End Frame"
          },
          "fps": {
            "type": "number",
            "title": "Fps"
          },
          "duration_sec": {
            "type": "number",
            "title": "Duration Sec"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "neighbours": {
            "items": {
              "$ref": "#/components/schemas/NeighbourFrame"
            },
            "type": "array",
            "title": "Neighbours"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "frame_id",
          "keyframe_n",
          "pts_sec",
          "shot_id",
          "shot_start_sec",
          "shot_end_sec",
          "shot_start_frame",
          "shot_end_frame",
          "fps",
          "duration_sec",
          "width",
          "height",
          "neighbours"
        ],
        "title": "FrameContext",
        "description": "Everything the verify panel shows about one retrieved keyframe.\n\n`frame_id` is `original_frame_id` \u2014 what a submission reports. It is not a\nkey: two keyframes of the same video can share one, so `keyframe_n` is the\nidentity and the first match wins here."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionEntity": {
        "type": "string",
        "enum": [
          "frames",
          "clips",
          "asr_segments"
        ],
        "title": "IngestionEntity"
      },
      "IngestionFeatureProfilesResponse": {
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/FeatureProfileOption"
            },
            "type": "array",
            "title": "Profiles"
          },
          "default_profile": {
            "type": "string",
            "title": "Default Profile"
          }
        },
        "type": "object",
        "required": [
          "profiles",
          "default_profile"
        ],
        "title": "IngestionFeatureProfilesResponse"
      },
      "IngestionJobListResponse": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/IngestionJobStatusResponse"
            },
            "type": "array",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "jobs"
        ],
        "title": "IngestionJobListResponse"
      },
      "IngestionJobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/IngestionStatus"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestionStage"
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestionProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "collection_name": {
            "type": "string",
            "title": "Collection Name"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "collection_name"
        ],
        "title": "IngestionJobStatusResponse"
      },
      "IngestionProgress": {
        "properties": {
          "completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completed"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percent"
          }
        },
        "type": "object",
        "required": [
          "completed",
          "total",
          "percent"
        ],
        "title": "IngestionProgress"
      },
      "IngestionStage": {
        "type": "string",
        "enum": [
          "validating",
          "creating_collection",
          "creating_payload_indexes",
          "upserting",
          "optimizing",
          "completed"
        ],
        "title": "IngestionStage"
      },
      "IngestionStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "IngestionStatus"
      },
      "KisCandidate": {
        "properties": {
          "task": {
            "type": "string",
            "const": "kis",
            "title": "Task"
          },
          "video_id": {
            "type": "string",
            "pattern": "^L\\d{2}_V\\d{3}$",
            "title": "Video Id"
          },
          "frame_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Frame Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task",
