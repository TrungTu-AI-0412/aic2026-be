    "/api/v1/videos/{video_id}/frames/{frame_id}/context": {
      "get": {
        "tags": [
          "Media"
        ],
        "summary": "Get Frame Context",
        "description": "Metadata for one keyframe plus its neighbouring keyframes.\n\nOne request per verify panel: the neighbour thumbnails are then plain\n`/frames/{frame_id}` reads and the clip preview is `/stream#t=pts_sec`.",
        "operationId": "get_frame_context_api_v1_videos__video_id__frames__frame_id__context_get",
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Video Id"
            }
          },
          {
            "name": "frame_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Frame Id"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 0,
              "description": "Neighbouring keyframes each side.",
              "default": 5,
              "title": "Radius"
            },
            "description": "Neighbouring keyframes each side."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameContext"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/stream": {
      "get": {
        "tags": [
          "Media"
        ],
        "summary": "Stream Video",
        "description": "Stream the source video for in-place playback.\n\nSeek on the client: `<video src=\".../stream#t=12.5\">`. FileResponse honours\nRange requests, so the browser pulls only the bytes around that timestamp\ninstead of the file, and nothing is decoded or re-encoded server side.",
        "operationId": "stream_video_api_v1_videos__video_id__stream_get",
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
